{% endif %}

<noscript>{{ 'component-reviews.css' | asset_url | stylesheet_tag }}</noscript>
<style>
 @media (min-width:990px){
    .product-media-gallery-wrap{
          max-width: {{section.settings.product_images_width}}px;
    }
  }
