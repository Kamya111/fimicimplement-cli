											{{ block.settings.text }}
										</div>
									{% endif %}

									{% if block.settings.show_facebook or block.settings.show_twitter or block.settings.show_linkedin %}
										<div class="product-info-extra-sharing">
											<ul class="list-social">
												{% if block.settings.show_facebook %}
													<li class="list-social-item">
														<a href="https://www.facebook.com/sharer.php?u={{ shop.url }}{{ product.url | url_encode }}" data-share-url="https://www.facebook.com/sharer.php?u=" target="_blank" class="list-social-link">															<span class="visually-hidden">{{ 'general.social.share_on_facebook' | t }}</span>
															{% render 'icon-facebook' %}
														</a>
													</li>
												{% endif %}
												{% if block.settings.show_twitter %}
													<li class="list-social-item">
														<a href="https://twitter.com/share?url={{ shop.url }}{{ product.url | url_encode }}" data-share-url="https://twitter.com/share?url=" target="_blank" class="list-social-link">															<span class="visually-hidden">
																{% if settings.social_link_twitter_use_x %}
																	{{ 'general.social.links.x' | t }}
																{% else %}
																	{{ 'general.social.links.twitter' | t }}
																{% endif %}
															</span>
															{% if settings.social_link_twitter_use_x %}
																{% render 'icon-x' %}
															{% else %}
																{% render 'icon-twitter' %}
															{% endif %}
														</a>
													</li>
												{% endif %}
												{% if block.settings.show_linkedin %}
													<li class="list-social-item">
														<a href="https://www.linkedin.com/sharing/share-offsite/?url={{ shop.url }}{{ product.url | url_encode }}" data-share-url="https://www.linkedin.com/sharing/share-offsite/?url=" target="_blank" class="list-social-link">															<span class="visually-hidden">{{ 'general.social.share_on_linkedin' | t }}</span>
															{% render 'icon-linkedin' %}
														</a>
													</li>
												{% endif %}
											</ul>
										</div>
									{% endif %}
								</div>
						{% endcase %}
					{% endfor %}
				</div>
			</div>

			{% if is_page_expanded %}
				<div class="product-info-sidebar">
					{% for block in section.blocks %}
						{% case block.type %}
							{%- when 'details' -%}
								{% capture output %}
									{% if block.settings.show_type and product.type != blank %}
										<li class="product-info-details-item">
											<span class="product-info-details-item-label">{{ 'products.product.type' | t }}</span>
											<span class="product-info-details-item-value">{{ product.type }}</span>
										</li>
									{% endif %}
									{% if block.settings.show_vendor and product.vendor != blank %}
										<li class="product-info-details-item">
											<span class="product-info-details-item-label">{{ 'products.product.vendor' | t }}</span>
											<span class="product-info-details-item-value">{{ product.vendor }}</span>
										</li>
									{% endif %}
									{% if block.settings.show_sku and product.selected_or_first_available_variant.sku != blank %}
										<li class="product-info-details-item">
											<span class="product-info-details-item-label">{{ 'products.product.sku' | t }}</span>
											<span class="product-info-details-item-value">{{ product.selected_or_first_available_variant.sku }}</span>
										</li>
									{% endif %}
									{% if block.settings.show_barcode and product.selected_or_first_available_variant.barcode != blank %}
										<li class="product-info-details-item">
											<span class="product-info-details-item-label">{{ block.settings.barcode_label }}</span>
											<span class="product-info-details-item-value">{{ product.selected_or_first_available_variant.barcode }}</span>
										</li>
									{% endif %}

									{% render 'product-metafields', product: product, metafields_list: block.settings.metafields %}
								{% endcapture %}

								{% if output != blank or request.design_mode %}
									<div id="ProductInfoDetails-{{ section.id }}-{{ block.id }}-{{ forloop.index0 }}" class="product-info-details" {{ block.shopify_attributes }}>
										{% if block.settings.title != blank %}
											<h4 class="product-info-details-title h5">
												{% if block.settings.icon != blank %}
													{% render 'icons', icon: block.settings.icon %}
												{% endif %}
												{{ block.settings.title }}
											</h4>
										{% endif %}

										<ul class="product-info-details-list">
											{{ output }}
										</ul>
									</div>
								{% endif %}
							{%- when 'custom_liquid' -%}
								{% liquid
									if block.settings.position != "details"
										continue
									endif
								%}
								{% capture liquid_output %}{{ block.settings.custom_liquid }}{% endcapture %}
								{% if liquid_output != blank %}
									<div class="custom-liquid-right" {{ block.shopify_attributes }}>
										{% if block.settings.title != blank or block.settings.icon != blank %}
											<h4 class="product-info-details-title h5">
												{% if block.settings.icon != blank %}
													{% render 'icons', icon: block.settings.icon %}
												{% endif %}
												{{ block.settings.title }}
											</h4>
										{% endif %}

										{{ block.settings.custom_liquid }}
									</div>
								{% endif %}
							{% when 'extra' %}
								<div class="product-info-extra" {{ block.shopify_attributes }}>
									{% if block.settings.text != blank %}
										<div class="product-info-extra-aux rte">
											{{ block.settings.text }}
										</div>
									{% endif %}

									{% if block.settings.show_facebook or block.settings.show_twitter or block.settings.show_linkedin %}
										<div class="product-info-extra-sharing">
											<ul class="list-social">
												{% if block.settings.show_facebook %}
													<li class="list-social-item">
														<a href="https://www.facebook.com/sharer.php?u={{ shop.url }}{{ product.url | url_encode }}" target="_blank" class="list-social-link">
															<span class="visually-hidden">{{ 'general.social.share_on_facebook' | t }}</span>
															{% render 'icon-facebook' %}
														</a>
													</li>
												{% endif %}
												{% if block.settings.show_twitter %}
													<li class="list-social-item">
														<a href="https://twitter.com/share?url={{ shop.url }}{{ product.url | url_encode }}" target="_blank" class="list-social-link">
															<span class="visually-hidden">
																{% if settings.social_link_twitter_use_x %}
																	{{ 'general.social.links.x' | t }}
																{% else %}
																	{{ 'general.social.links.twitter' | t }}
																{% endif %}
															</span>
															{% if settings.social_link_twitter_use_x %}
																{% render 'icon-x' %}
															{% else %}
																{% render 'icon-twitter' %}
															{% endif %}
														</a>
													</li>
												{% endif %}
												{% if block.settings.show_linkedin %}
													<li class="list-social-item">
														<a href="https://www.linkedin.com/sharing/share-offsite/?url={{ shop.url }}{{ product.url | url_encode }}" target="_blank" class="list-social-link">
															<span class="visually-hidden">{{ 'general.social.share_on_linkedin' | t }}</span>
															{% render 'icon-linkedin' %}
														</a>
													</li>
												{% endif %}
											</ul>
										</div>
									{% endif %}
								</div>
						{% endcase %}
					{% endfor %}
				</div>
			{% endif %}

			<div class="product-info-description">
				<div class="product-info-description-content">
					<tabs-navigation for="TabComponent-{{ section.id }}" class="product-tab-navigation">
						<div class="tab-nav-wrap">
							<div class="tab-nav">
								{% liquid
									assign count = 0
								%}
								{% for block in section.blocks %}
									{% case block.type %}
										{% when 'custom_liquid' %}
											{% capture liquid_output %}{{ block.settings.custom_liquid }}{% endcapture %}
											{% liquid
												if block.settings.position != "tab" or liquid_output == blank
													continue
												endif
											%}
												<a
													href="#"
													class="tab-nav-item {% if count == 0 %}is-active{% endif %}"
													data-handle="{{ section.id }}-{{ block.id }}-{{ forloop.index0 }}"
													{{ block.shopify_attributes }}
												>
													{% if block.settings.icon != blank %}
														{% render 'icons', icon: block.settings.icon %}
													{% endif %}
													{{ block.settings.title }}
												</a>
											{% liquid
												assign count = count | plus: 1
											%}
										{% when 'description' %}
											{% if product.description != blank %}
												<a
													href="#"
													class="tab-nav-item {% if count == 0 %}is-active{% endif %}"
													data-handle="{{ section.id }}-{{ block.id }}-{{ forloop.index0 }}"
													{{ block.shopify_attributes }}
												>
													{% if block.settings.icon != blank %}
														{% render 'icons', icon: block.settings.icon %}
													{% endif %}
													{{ block.settings.title }}
												</a>
												{% liquid
													assign count = count | plus: 1
												%}
											{% endif %}
										{% when 'reviews' %}
											<a
												href="#"
												id="product-reviews"
												class="tab-nav-item {% if count == 0 %}is-active{% endif %} {% if product.metafields.reviews.rating_count != blank %}tab-nav-item-has-reviews{% endif %}"
												data-handle="{{ section.id }}-{{ block.id }}-{{ forloop.index0 }}"
												{{ block.shopify_attributes }}
											>
												{% if product.metafields.reviews.rating_count != blank %}
													{% render 'icon-star-full' %}
												{% else %}
													{% render 'icon-star-empty' %}
												{% endif %}
												{{ 'products.product.reviews' | t }}
											</a>
											{% liquid
												assign count = count | plus: 1
											%}
										{% when 'tab' %}
											{% if block.settings.text != blank %}
												<a
													href="#"
													class="tab-nav-item {% if count == 0 %}is-active{% endif %}"
													data-handle="{{ section.id }}-{{ block.id }}-{{ forloop.index0 }}"
													{{ block.shopify_attributes }}
												>
													{% if block.settings.icon != blank %}
														{% render 'icons', icon: block.settings.icon %}
													{% endif %}
													{{ block.settings.title }}
												</a>
												{% liquid
													assign count = count | plus: 1
												%}
											{% endif %}
									{% endcase %}
								{% endfor %}
							</div>
						</div>
					</tabs-navigation>

					<tabs-component id="TabComponent-{{ section.id }}" class="product-tabs-component">
						{% liquid
							assign count = 0
						%}
						{% for block in section.blocks %}
							{% case block.type %}
								{% when 'custom_liquid' %}
									{% capture liquid_output %}{{ block.settings.custom_liquid }}{% endcapture %}
									{% liquid
										if block.settings.position != "tab" or liquid_output == blank
											continue
										endif
									%}
									<div
										class="tabs-component-content color-background-2"
										data-handle="{{ section.id }}-{{ block.id }}-{{ forloop.index0 }}"
										aria-hidden="{% if count != 0 %}true{% else %}false{% endif %}"
									>
										{{ block.settings.custom_liquid }}
									</div>
									{% liquid
										assign count = count | plus: 1
									%}
								{% when 'description' %}
									{% if product.description != blank %}
										<div
											class="tabs-component-content color-background-2"
											data-handle="{{ section.id }}-{{ block.id }}-{{ forloop.index0 }}"
											aria-hidden="{% if count != 0 %}true{% else %}false{% endif %}"
										>
											<div class="rte">
												{{ product.description }}
											</div>
										</div>
										{% liquid
											assign count = count | plus: 1
										%}
									{% endif %}
								{% when 'reviews' %}
									<div
										class="tabs-component-content tabs-component-content-reviews color-background-2"
										data-handle="{{ section.id }}-{{ block.id }}-{{ forloop.index0 }}"
										aria-hidden="{% if count != 0 %}true{% else %}false{% endif %}"
									>
										{% render 'product-review-widget' %}
									</div>
									{% liquid
										assign count = count | plus: 1
									%}
								{% when 'tab' %}
									{% if block.settings.text != blank %}
										<div
											class="tabs-component-content color-background-2"
											data-handle="{{ section.id }}-{{ block.id }}-{{ forloop.index0 }}"
											aria-hidden="{% if count != 0 %}true{% else %}false{% endif %}"
										>
											{{ block.settings.text }}
										</div>
										{% liquid
											assign count = count | plus: 1
										%}
									{% endif %}
							{% endcase %}
						{% endfor %}
					</tabs-component>
				</div>
			</div>
		</div>
	</div>
</div>

{%- if first_3d_model -%}
	<script type="application/json" id="ProductJSON-{{ product.id }}">
		{{ product.media | where: 'media_type', 'model' | json }}
	</script>

	<script src="{{ 'product-model.js' | asset_url }}" defer></script>
{%- endif -%}

{% if product.media.size > 0 %}
	<script src="{{ 'flickity.pkgd.js' | asset_url }}" defer="defer"></script>
	<script src="{{ 'media-gallery.js' | asset_url }}" defer="defer"></script>
	<script src="{{ 'product-modal.js' | asset_url }}" defer="defer"></script>
{% endif %}

{%- liquid
	if product.selected_or_first_available_variant.featured_media
		assign seo_media = product.selected_or_first_available_variant.featured_media
	else
		assign seo_media = product.featured_media
	endif
-%}

<script type="application/ld+json">
	{
		"@context": "http://schema.org/",
		"@type": "Product",
		"name": {{ product.title | json }},
		"url": {{ request.origin | append: product.url | json }},
		{% if seo_media -%}
			"image": [
				{{ seo_media | image_url: width: 1920 | prepend: "https:" | json }}
			],
		{%- endif %}
		"description": {{ product.description | strip_html | json }},
		{% if product.selected_or_first_available_variant.sku != blank -%}
			"sku": {{ product.selected_or_first_available_variant.sku | json }},
		{%- endif %}
		"brand": {
			"@type": "Brand",
			"name": {{ product.vendor | json }}
		},
		"offers": [
			{%- for variant in product.variants -%}
				{
					"@type" : "Offer",
					{%- if variant.sku != blank -%}
						"sku": {{ variant.sku | json }},
					{%- endif -%}
					{%- if variant.barcode.size == 12 -%}
						"gtin12": {{ variant.barcode }},
					{%- endif -%}
					{%- if variant.barcode.size == 13 -%}
						"gtin13": {{ variant.barcode }},
					{%- endif -%}
					{%- if variant.barcode.size == 14 -%}
						"gtin14": {{ variant.barcode }},
					{%- endif -%}
					"availability" : "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
					"price" : {{ variant.price | divided_by: 100.00 | json }},
					"priceCurrency" : {{ cart.currency.iso_code | json }},
					"url" : {{ request.origin | append: variant.url | json }}
				}{% unless forloop.last %},{% endunless %}
			{%- endfor -%}
		]
	}
</script>

