<style>
   .custom_banner_image{
    height:{{section.settings.section-height}}vh;
  }
  .custom_banner_content h1{
    font-size:{{section.settings.heading_font_size}}px;
  }
  @media (max-width:749px){
.custom_banner_image{
    height:{{section.settings.mobile_section-height}}vh;
  }
.custom_banner_content h1{
    font-size:{{section.settings.mobile_heading_font_size}}px;
  }
  } 
  .kik_heading_h2{font-size:32px;line-height:40px;margin-bottom:32px;font-weight:800}.kik_heading_h4{font-size:22px;line-height:26.4px;margin-bottom:32px;font-weight:800}.kik_primary_button,.kik_secondary_button{padding:16px 48px;font-size:17px;line-height:25.5px;font-weight:800}.kik_color_white{color:#fff}.kik_primary_button{background:#ca141c;color:#fff}.kik_secondary_button{background:#fff;color:#ca141c}.custom_banner_item{position:relative}.custom_banner_image img{width:100%;height:100%;object-fit:cover}.custom_banner_content{position:absolute;top:0;left:0;width:100%;height:100%;padding:20px;display:flex;align-items:center;justify-content:center}.custom_banner_content>div{max-width:770px;text-align:center}.custom_banner_content h1{margin:0 0 16px;line-height:1.2;font-weight:800}.custom_banner_content p{font-size:18px;line-height:27px;margin-bottom:24px}.custom_banner_content a{display:block;width:fit-content;margin:0 auto}@media (max-width:749px){.kik_heading_h2{font-size:24px;line-height:28.8px;margin-bottom:20px}.kik_heading_h4{font-size:20px;line-height:24px;margin-bottom:32px}.kik_primary_button,.kik_secondary_button{padding:12px 32px;font-size:14px;line-height:21px}.custom_banner_item{position:relative}.custom_banner_content>div{text-align:left}.custom_banner_content{position:absolute;top:0;left:0;width:100%;height:100%;padding:15px;display:flex;align-items:flex-end;justify-content:center}.custom_banner_content h1{margin:0 0 10px;line-height:1.2}.custom_banner_content p{font-size:18px;line-height:27px;margin-bottom:24px}}
</style>
<div class="custom_banner_c">
  {% for block in section.blocks %}
  <div class="custom_banner_item">
    <div class="custom_banner_image">
       <img src="{{ block.settings.image | img_url:"400x400" }}"           
              alt="{{ block.settings.image.alt }}"
          srcset="{{ block.settings.image | img_url: '400x400' }} 400w, {{ block.settings.image | img_url: '800x800' }} 800w, {{ block.settings.image | img_url: '1024x1024' }} 1024w" 
              sizes="(max-width: 600px) 400px, (max-width: 900px) 400px, 1024px" 
              loading="lazy" width='100%' height="auto">
    </div>
    <div class="custom_banner_content">
      <div>
        <h1 class="kik_color_white">{{ block.settings.heading }}</h1>
        <p class="kik_color_white">{{ block.settings.text }}</p>
        {% if block.settings.link != blank %}
            <a class="kik_primary_button" href='{{ block.settings.link }}'>{{ block.settings.button_text }}</a>
        {% endif %}
      </div>
    </div>
  </div>
  {% endfor %}
</div>
{% schema %}
{
  "name": "kik banner",
  "settings": [
   {
      "type" : "range",
      "id" : "section-height",
      "label" : "section height",
      "min" : 20,
      "max":120,
      "step":1,
      "default" :80
      },
       {
      "type" : "range",
      "id" : "heading_font_size",
      "label" : "heading font size",
      "min" : 10,
      "max":100,
      "step":1,
      "default" :48
      },
     {
      "type" : "header",
      "content" : "mobile",
      },
      {
      "type" : "range",
      "id" : "mobile_section-height",
      "label" : "section height",
      "min" : 20,
      "max":120,
      "step":1,
      "default" :50
      },
       {
      "type" : "range",
      "id" : "mobile_heading_font_size",
      "label" : "heading font size",
      "min" : 10,
      "max":100,
      "step":1,
      "default" :24
      },
  ],
  "blocks": [
      {
        "type": "banner",
        "name": "banner",
        "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label":"image"
    },
           {
      "type": "image_picker",
      "id": "mobile_image",
      "label":"mobile image"
    },
          {
      "type": "text",
      "id": "heading",
      "label":"heading"
    },
           {
      "type": "textarea",
      "id": "text",
      "label":"text"
    },
             {
      "type": "url",
      "id": "link",
      "label":"link"
    },
           {
      "type": "text",
      "id": "button_text",
      "label":"button text"
    }
        ]
      }
    ],
  "presets": [
    {
      "name":"kik banner",
      "category":"image"
    }
  ]
}
{% endschema %}