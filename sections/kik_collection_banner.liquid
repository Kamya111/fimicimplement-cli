<style>
  .custom_banner_image{
      height:{{section.settings.section-height}}vh;
    }
      @media (max-width:749px){
    .custom_banner_image{
      height:{{section.settings.mobile_section-height}}vh;
    }
}
.breadcrumb{font-size:16px;line-height:24px;padding:24px 0}.breadcrumb a:last-child{color:#3b3b3b}.breadcrumb span{margin:0 8px}.kik_color_white{color:#fff}.custom_banner_item{position:relative}.custom_banner_image img{width:100%;height:100%;object-fit:cover}.custom_banner_content{position:absolute;top:0;left:0;width:100%;height:100%;display:flex;align-items:flex-end;background:linear-gradient(40deg,#00000066,#66666600)}.custom_banner_content .container{width:100%}.custom_banner_content .container>div{width:100%;padding:40px 0}.custom_banner_content h1{margin:0;font-size:32px;line-height:1.2;font-weight:800}.custom_banner_content p{margin-top:16px;font-size:16px;line-height:24px}@media (max-width:749px){.custom_banner_content{align-items:flex-end}.custom_banner_content h1{margin:0;font-size:24px;line-height:32px}.custom_banner_content p{font-size:14px;line-height:21px}}
</style>
{% if collection.featured_image != blank %}
  <div class="custom_banner_c">
    <div class="custom_banner_item">
      <div class="custom_banner_image">
           <img src="{{ collection.featured_image  | img_url:"master" }}"           
        alt="{{ collection.featured_image.alt }}"
    srcset="{{ collection.featured_image | img_url: '400x400' }} 400w, {{ collection.featured_image | img_url: '800x800' }} 800w, {{ collection.featured_image | img_url: '1024x1024' }} 1024w" 
        sizes="(max-width: 600px) 400px, (max-width: 900px) 400px, 1024px" 
        loading="eager" fetchPriority="high" width='100%' height="auto">
      </div>
      <div class="custom_banner_content">
        <div class="container">
          <div>
            <h1 class="kik_color_white">{{ collection.title }}</h1>
            {% comment %}
            {% if collection.description != blank %}
              <p class="kik_color_white">{{ collection.description }}</p>
            {% endif %}
            {% endcomment %}
          </div>
        </div>
      </div>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "kik collection banner",
  "settings": [
   {
      "type" : "range",
      "id" : "section-height",
      "label" : "section height",
      "min" : 20,
      "max":220,
      "step":2,
      "default" :80
      },
     {
      "type" : "header",
      "content" : "mobile",
      },
      {
      "type" : "range",
      "id" : "mobile_section-height",
      "label" : "section height",
      "min" : 20,
      "max":220,
      "step":2,
      "default" :50
      },
  ],
  "presets": [
    {
      "name": "kik collection banner",
      "category": "image"
    }
  ]
}
{% endschema %}
