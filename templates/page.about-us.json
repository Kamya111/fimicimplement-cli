        "text_nVVEdg": {
          "type": "text",
          "settings": {
            "text": "<p>FIMIC, LLC. It started with a simple yet ambitious goal: reshaping the agricultural equipment distribution market. We began our journey in 2017, driven by a vision, powered by expertise, and operating out of a modest 5,000-square-foot warehouse.</p>",
            "text_size": "md"
